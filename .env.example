# Turso Cloud (libSQL). NOT "Turso Database", which is the separate Rust rewrite.
#
# Point this at ai4logistics-dev. Never at ai4logistics-prod: there is no reason for production
# credentials to exist on a laptop, and the production migration runs in GitHub
# Actions instead. See docs/ENVIRONMENTS.md.
#
#   turso db show ai4logistics-dev --url
#   turso db tokens create ai4logistics-dev
TURSO_DATABASE_URL="libsql://ai4logistics-dev-<your-org>.turso.io"
TURSO_AUTH_TOKEN=""

# Vercel Blob: fiscal XML and POD photos. Never store blobs in Turso.
BLOB_READ_WRITE_TOKEN=""

# Fiscal emission provider. See ADR 0003 - still open.
# While open, the fake provider is the default and needs no credentials.
FISCAL_PROVIDER="fake"
FISCAL_PROVIDER_API_KEY=""
FISCAL_PROVIDER_BASE_URL=""

# Notifications
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Protects the Vercel Cron endpoints from public invocation.
CRON_SECRET=""

# MDF-e closure alert threshold, in hours.
# WARNING: 24 is a GUESS and is not sourced. See docs/domain/glossary.md.
# The core feature of this product is built on this number. Source it.
MDFE_CLOSURE_ALERT_HOURS="24"
