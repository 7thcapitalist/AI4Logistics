{
  "name": "ai4logistics",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @ai4l/db generate",
    "db:migrate": "pnpm --filter @ai4l/db migrate",
    "db:seed": "pnpm --filter @ai4l/db seed",
    "db:check": "pnpm --filter @ai4l/db check",
    "format": "prettier --write .",
    "hooks:install": "git config core.hooksPath .githooks && echo 'pre-push hook installed'",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "drizzle-orm": "^0.33.0"
  }
}
